# ── TAXIMETER.GOV Enterprise Gov — Variables d'environnement ──
# Copier ce fichier en .env.local et remplir vos valeurs Supabase

# URL publique Supabase (ex: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clé publiable Supabase (safe pour le navigateur — commence par sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# Clé service role (JAMAIS exposée côté client)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXX
